{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "Normalized Bitcoin network transaction record for anomaly detection and entity intelligence",
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "description": "Unique transaction hash or identifier",
          "maxLength": 128
        },
        "txid": {
          "type": "string",
          "description": "Bitcoin transaction ID hash",
          "maxLength": 128
        },
        "amount": {
          "type": "number",
          "description": "Transaction value in BTC"
        },
        "riskScore": {
          "type": "number",
          "description": "Computed composite risk score from 0 to 100"
        },
        "status": {
          "type": "string",
          "description": "Processing and triage status",
          "enum": ["pending", "confirmed", "flagged", "blocked"]
        },
        "script_type": {
          "type": "string",
          "description": "Bitcoin script type",
          "enum": ["P2PKH", "P2SH", "P2WPKH", "P2WSH", "TAPROOT"]
        },
        "src_ip": {
          "type": "string",
          "description": "Source relay node IP address",
          "maxLength": 64
        },
        "dst_ip": {
          "type": "string",
          "description": "Destination relay node IP address",
          "maxLength": 64
        },
        "geo_country": {
          "type": "string",
          "description": "ISO 2-letter country code of relay origin",
          "maxLength": 8
        },
        "asn": {
          "type": "string",
          "description": "Autonomous System Number",
          "maxLength": 32
        },
        "pattern_type": {
          "type": "string",
          "description": "Detected behavioral or structural pattern",
          "maxLength": 64
        }
      },
      "required": ["transactionId", "amount", "riskScore", "status"]
    },
    "Alert": {
      "title": "Alert",
      "description": "Triaged security alert generated by BTC-SHIELD anomaly detection engine",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique alert identifier",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Alert title or summary",
          "maxLength": 256
        },
        "severity": {
          "type": "string",
          "description": "Alert severity level",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "status": {
          "type": "string",
          "description": "Current investigation review status",
          "enum": ["NEW", "IN_REVIEW", "INVESTIGATING", "CLOSED"]
        },
        "txid": {
          "type": "string",
          "description": "Target transaction hash",
          "maxLength": 128
        },
        "risk_score": {
          "type": "number",
          "description": "Risk score at alert trigger time"
        }
      },
      "required": ["id", "severity", "status"]
    },
    "Investigation": {
      "title": "Investigation",
      "description": "Forensic case dossier compiled by security analysts",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique investigation case ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Case title or entity focus",
          "maxLength": 256
        },
        "status": {
          "type": "string",
          "description": "Investigation lifecycle state",
          "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "ARCHIVED"]
        },
        "primaryEntityId": {
          "type": "string",
          "description": "Primary suspect wallet address or node IP",
          "maxLength": 128
        }
      },
      "required": ["id", "title", "status"]
    }
  },
  "firestore": {
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Live and normalized Bitcoin transaction events"
    },
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Intelligence alerts generated from anomaly detection"
    },
    "/investigations/{investigationId}": {
      "schema": "Investigation",
      "description": "Forensic case dossiers and evidence records"
    }
  }
}
